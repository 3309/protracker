includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/

    level: 7

    ignoreErrors:
        # These traits are used by the single-file Livewire pages in resources/views/pages, which PHPStan does not read.
        -
            identifier: trait.unused
            path: app/Livewire/Concerns/*
